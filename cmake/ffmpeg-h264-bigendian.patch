# The H.264 decoder's SEI picture hashes (libavcodec/h274.c) call ff_bswapdsp_init on a big-endian host, which
# configure doesn't select for the decoder: a build with only the decoders NVDEC handles (cmake/ffmpeg.cmake) fails
# to link there. On a little-endian host nothing calls it, so the object stays out of the link.
#
# cmake/ffmpeg.cmake applies it to a copy of the release and checks the result. To change it, edit a copy of the
# pristine file, rebuild the hunks with `diff -u --label a/<file> --label b/<file>`, and update the hash there.
--- a/configure
+++ b/configure
@@ -3215,7 +3215,7 @@
 h263i_decoder_select="h263_decoder"
 h263p_decoder_select="h263_decoder"
 h263p_encoder_select="h263_encoder"
-h264_decoder_select="cabac golomb h264chroma h264dsp h264parse h264pred h264qpel h264_sei videodsp"
+h264_decoder_select="bswapdsp cabac golomb h264chroma h264dsp h264parse h264pred h264qpel h264_sei videodsp"
 h264_decoder_suggest="error_resilience"
 hap_decoder_select="snappy texturedsp"
 hap_encoder_deps="libsnappy"
