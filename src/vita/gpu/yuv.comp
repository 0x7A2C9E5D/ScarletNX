#version 450
#extension GL_GOOGLE_include_directive : require
/* SPDX-License-Identifier: GPL-3.0-or-later
   Copyright 2026 the ScarletNX contributors */
/* A YUV420 texture (a movie's frames) made R8G8B8A8 rows on the GPU before its copy into the texture's image
   (render.c): the guest's bytes are read where they are. The body is yuv.glsl, which the tests also run on the CPU */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

/* render.c's YuvParams, member for member */
layout(push_constant) uniform Params {
    uint pixels;  /* width x height */
    uint width;
    uint height;
    uint y_at;    /* the Y plane's first byte in the bound source */
    uint c_at;    /* the chroma's */
    uint stride;  /* bytes a Y row */
    uint packed;  /* nonzero: interleaved chroma (P2), else two planes (P3) */
    uint first_v; /* V's byte, or plane, first */
    uint rv;      /* the matrix: R's V, G's U and V, B's U, 8-bit fixed point */
    uint gu;
    uint gv;
    uint bu;
};

layout(std430, binding = 0) readonly restrict buffer Src {
    uint src[];
};
layout(std430, binding = 1) writeonly restrict buffer Dst {
    uint dst[];
};

#include "yuv.glsl"
