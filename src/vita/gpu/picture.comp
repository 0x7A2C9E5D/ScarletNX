#version 450
#extension GL_GOOGLE_include_directive : require
/* SPDX-License-Identifier: GPL-3.0-or-later
   Copyright 2026 the ScarletNX contributors */
/* A decoded picture into the game's buffer on the GPU (render.c's vita_render_picture runs it for sceAvcdecDecode):
   its planes are staged as they are, and the layout the game asked for is made here. The body is picture.glsl, which
   the tests also run on the CPU */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

/* render.c's PictureParams, member for member */
layout(push_constant) uniform Params {
    uint words;  /* the picture's words in the game's buffer */
    uint luma;   /* the Y plane's bytes there: pitch x height */
    uint pitch;  /* bytes a Y row */
    uint width;  /* the picture's width and height in pixels, even */
    uint height;
    uint u_at;   /* where U's and V's staged planes start */
    uint v_at;
    uint packed; /* nonzero: chroma interleaved (P2), else U's plane then V's (P3) */
    uint vu;     /* interleaved V first */
};

layout(std430, binding = 0) readonly restrict buffer Src {
    uint src[];
};
layout(std430, binding = 1) writeonly restrict buffer Dst {
    uint dst[];
};

#include "picture.glsl"
