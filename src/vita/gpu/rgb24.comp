#version 450
#extension GL_GOOGLE_include_directive : require
/* SPDX-License-Identifier: GPL-3.0-or-later
   Copyright 2026 the ScarletNX contributors */
/* A 24-bit color surface's memory made R8G8B8A8 rows before their copy into its image, and the rows copied out of it
   made its memory again (render.c): the guest's bytes are read and written where they are. The body is rgb24.glsl,
   which the tests also run on the CPU */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

/* render.c's Rgb24Params, member for member */
layout(push_constant) uniform Params {
    uint words;  /* unpack: the rows' pixels; pack: the destination's words from its bound start */
    uint src_at; /* unpack: the surface's first byte in the bound source */
    uint dst_at; /* pack: the surface's first byte in the bound destination */
    uint width;
    uint height;
    uint stride; /* pixels a row of the surface */
    uint pack;   /* nonzero: rows to the surface, else the surface to rows */
    uint bgr;    /* nonzero: the RGB swizzle, B in a pixel's first byte */
};

layout(std430, binding = 0) readonly restrict buffer Src {
    uint src[];
};
layout(std430, binding = 1) restrict buffer Dst {
    uint dst[];
};

#include "rgb24.glsl"
